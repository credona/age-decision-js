{
  "name": "@credona/age-decision",
  "version": "2.6.0",
  "description": "JavaScript and TypeScript SDK for Age Decision API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "project.json",
    "compatibility.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run tests/*.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "pack:check": "npm pack --dry-run",
    "test:unit": "vitest run tests/*.test.ts",
    "check:metadata": "node scripts/metadata/check-project-metadata.mjs && node scripts/metadata/check-compatibility-metadata.mjs",
    "check:release": "node scripts/metadata/check-release-metadata.mjs",
    "integration:sync": "node scripts/integration/update-compose-integration.mjs",
    "docs:generate": "node scripts/docs/update-compatibility.mjs && node scripts/docs/update-readme-examples.mjs && node scripts/docs/update-docs-usage.mjs && node scripts/docs/update-docs-types.mjs && node scripts/docs/update-docs-compatibility.mjs && node scripts/docs/update-contributing.mjs && node scripts/docs/update-changelog-release-section.mjs",
    "check:all": "scripts/ci/check_all.sh",
    "check:local": "scripts/dev/check_local.sh",
    "check:docker": "scripts/ci/check_all_docker.sh",
    "fix:docker": "scripts/ci/fix_all_docker.sh",
    "release:prepare": "scripts/ci/release_prepare.sh"
  },
  "keywords": [
    "age-verification",
    "age-estimation",
    "anti-spoofing",
    "liveness",
    "computer-vision",
    "privacy",
    "typescript",
    "javascript",
    "sdk",
    "credona"
  ],
  "author": "Credona",
  "license": "Apache-2.0",
  "homepage": "https://github.com/credona/age-decision-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/credona/age-decision-js.git"
  },
  "bugs": {
    "url": "https://github.com/credona/age-decision-js/issues"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
